# Application
APP_NAME=KubeAudit
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api

# Security
SECRET_KEY=change-me-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
DATABASE_URL=postgresql+psycopg2://kubeaudit_user:kubeaudit_password@localhost:5432/kubeaudit

# CORS
CORS_ORIGINS=http://localhost:5173,https://kubeauditai.marcosvillegas.dev

# Kubernetes external cluster
KUBERNETES_CONNECTION_MODE=kubeconfig
KUBECONFIG_PATH=/opt/kubeaudit/kubeconfigs/demo-cluster.kubeconfig

# AI provider
AI_PROVIDER=disabled
AI_API_KEY=change-me
AI_MODEL=change-me

# Logging
LOG_LEVEL=INFO
AI_RECOMMENDATION_MAX_TOKENS=2000
